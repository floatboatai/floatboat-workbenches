{
  "schemaVersion": 1,
  "appId": "workbench.c5d010cf-ad2d-422b-9216-500ea96b3f60",
  "registryName": "pdf-js-studio",
  "name": "PDF 阅读室",
  "description": "本地 PDF 阅读、全文检索与逐页笔记",
  "version": "0.3.1",
  "changelog": "共享自动保存修复：成功保存后立即切换文档不再误报“本机缓存尚未修复”。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "pdf-originals",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "pdf-originals",
      "access": "read-write"
    },
    {
      "id": "pdfjs-assets",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "public/pdfjs"
    },
    {
      "id": "sample-pdf",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "public/sample.pdf"
    }
  ]
}
