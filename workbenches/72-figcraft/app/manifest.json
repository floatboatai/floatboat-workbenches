  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "upstream-notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    },
    {
      "id": "setup-guide",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "SETUP.md"
