{
  "schemaVersion": 1,
  "appId": "workbench.a3667b34-10cf-487d-8b1f-8790641ff94d",
  "registryName": "graphify-studio",
  "name": "知识地图 · Graphify",
  "description": "多份代码、文档与文本在本机抽取知识图谱：社区、力导向地图、路径、原文定位与报告导出",
  "version": "0.9.1",
  "changelog": "AI 功能默认使用 gemini-3.8-flash：工作台 SDK 在调用未指定模型时固定使用该模型，不再随 Floatboat 远端配置变化。应用其余功能不变。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [
    "llm"
  ],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "sample-corpus",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "sample/replenishment"
    },
    {
      "id": "acceptance-guide",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "ACCEPTANCE.md"
    },
    {
      "id": "upstream-notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    },
    {
      "id": "setup-guide",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "SETUP.md"
    }
  ]
}
