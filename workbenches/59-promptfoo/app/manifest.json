{
  "schemaVersion": 1,
  "appId": "workbench.8faf7ebf-85d9-4974-b0bf-b5b4e7b6151c",
  "registryName": "promptfoo-studio",
  "name": "Promptfoo 评测台",
  "description": "用例×提示版本×provider 评测矩阵：本机断言、录制回放、基线差异与逐项发布判断",
  "version": "0.9.0",
  "changelog": "0.9.0：Node 内执行评测（21 类确定性断言、javascript 沙箱、weight/threshold/assert-set）；回放录制输出、echo、脚本与 Floatboat 模型 provider；promptfooconfig.yaml 与结果 JSON 导入导出；运行对比、基线差异、发布门槛；CSV/HTML 报告；36 用例示例评测集；任务回执恢复与草稿导入。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [
    "llm"
  ],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "sample-config",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "samples/promptfooconfig.yaml"
    },
    {
      "id": "sample-recording",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "samples/recorded-run.json"
    },
    {
      "id": "upstream-notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    },
    {
      "id": "acceptance-notes",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "ACCEPTANCE.md"
    }
  ]
}
