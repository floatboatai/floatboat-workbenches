{
  "schemaVersion": 1,
  "appId": "workbench.aa560584-7514-48cc-ab26-59b010756b40",
  "registryName": "filerobot-image-editor-studio",
  "name": "Filerobot Image Editor 工作台",
  "description": "本地照片裁剪、调色、标注与尺寸调整，自动保存原图和可编辑工程",
  "version": "0.3.1",
  "changelog": "共享自动保存修复：成功保存后立即切换文档不再误报“本机缓存尚未修复”。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "originals",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "originals",
      "access": "read-write"
    },
    {
      "id": "third-party-notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "licenses"
    }
  ]
}
