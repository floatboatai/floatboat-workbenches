{
  "schemaVersion": 1,
  "appId": "workbench.a24c7c1e-6443-45ab-9036-36ee9faf22ed",
  "registryName": "pageindex-studio",
  "name": "页间 · PageIndex",
  "description": "长报告阅读：章节目录、原页证据、摘录审阅与引用问答",
  "version": "0.9.0",
  "changelog": "浏览器内PDF.js阅读与原文提取，无需外部服务即可打开示例和自有PDF；PDF书签或版面标题生成章节树；全文检索、选中原文摘录、引用与摘录在原页高亮；PageIndex服务改为可选章节树增强（含启动命令与重新检查）；PDF上限提高到64MiB/1000页；阅读器重排为文档菜单＋目录/原页/审阅。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [
    "llm"
  ],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "documents",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "documents",
      "access": "read-write"
    },
    {
      "id": "samples",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "samples"
    },
    {
      "id": "pdfjs-assets",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "pdfjs"
    },
    {
      "id": "upstream-notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    },
    {
      "id": "setup-guide",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "SETUP.md"
    }
  ]
}
