{
  "schemaVersion": 1,
  "appId": "workbench.a24c7c1e-6443-45ab-9036-36ee9faf22ed",
  "registryName": "pageindex-studio",
  "name": "页间 · PageIndex",
  "description": "长报告阅读：章节目录、原页证据、摘录审阅与引用问答",
  "version": "0.9.1",
  "changelog": "共享自动保存修复：成功保存后立即切换文档不再误报“本机缓存尚未修复”。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [
    "llm"
  ],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "documents",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "documents",
      "access": "read-write"
    },
    {
      "id": "samples",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "samples"
    },
    {
      "id": "pdfjs-assets",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "pdfjs"
    },
    {
      "id": "upstream-notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    },
    {
      "id": "setup-guide",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "SETUP.md"
    }
  ]
}
