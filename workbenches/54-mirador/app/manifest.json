{
  "schemaVersion": 1,
  "appId": "workbench.d5d1b826-078d-40f8-90fe-56b203898dc5",
  "registryName": "mirador-studio",
  "name": "馆藏对照室",
  "description": "本地扫描页双窗口对照、复核记录与可移植项目",
  "version": "0.3.1",
  "changelog": "共享自动保存修复：成功保存后立即切换文档不再误报“本机缓存尚未修复”。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "samples",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "src/assets"
    },
    {
      "id": "scans",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "scans",
      "access": "read-write"
    }
  ]
}
