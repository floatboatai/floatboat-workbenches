{
  "schemaVersion": 1,
  "appId": "workbench.3e32d86a-3d81-4334-a859-0d93894350c4",
  "registryName": "oasis-editor-studio",
  "name": "Oasis Editor 工作台",
  "description": "中文分页文稿编辑：样式、编号、表格、图片、脚注、公式、修订与批注，DOCX/PDF 往返",
  "version": "0.9.0",
  "changelog": "开始/插入/表格/审阅/布局功能区；原生菜单与对话框中文化；修订显示与逐条接受拒绝、批注；页边距/方向/纸张；中文换行与首行缩进修正；窄屏适合宽度；真实项目建议书示例。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "native",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "src/vendor/oasis-editor"
    },
    {
      "id": "fonts",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "fonts"
    },
    {
      "id": "notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    },
    {
      "id": "originals",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "originals",
      "access": "read-write"
    },
    {
      "id": "third-party-notices",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "THIRD-PARTY-NOTICES.md"
    }
  ]
}
