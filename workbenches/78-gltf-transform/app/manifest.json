{
  "schemaVersion": 1,
  "appId": "workbench.cdaf06c7-7f94-47f3-8c2b-0b77757a6ba4",
  "registryName": "gltf-transform-studio",
  "name": "glTF 模型优化台",
  "description": "导入 GLB/glTF/ZIP，逐步运行 glTF Transform 优化并对照报告，导出可压缩的 GLB",
  "version": "0.9.1",
  "changelog": "共享自动保存修复：成功保存后立即切换文档不再误报“本机缓存尚未修复”。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "models",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "models",
      "access": "read-write"
    },
    {
      "id": "notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    }
  ]
}
