{
  "schemaVersion": 1,
  "appId": "workbench.cdaf06c7-7f94-47f3-8c2b-0b77757a6ba4",
  "registryName": "gltf-transform-studio",
  "name": "glTF 模型优化台",
  "description": "导入 GLB/glTF/ZIP，逐步运行 glTF Transform 优化并对照报告，导出可压缩的 GLB",
  "version": "0.9.0",
  "changelog": "接受带扩展的 GLB、glTF+资源与 ZIP（≤64 MB，Draco/Meshopt 解码）；一键优化流水线（剪除、去重、焊接、简化、重采样、量化、展平、合并、实例化、居中、缩小贴图），每步可预览、撤销并附前后报告；贴图清单与替换、节点 TRS、动画片段；Meshopt/Draco 导出；风机样例。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "models",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "models",
      "access": "read-write"
    },
    {
      "id": "notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    }
  ]
}
