{
  "schemaVersion": 1,
  "appId": "workbench.cdaf06c7-7f94-47f3-8c2b-0b77757a6ba4",
  "registryName": "gltf-transform-studio",
  "name": "glTF 资产检查台",
  "description": "检查模型节点、材质与资源，生成可回读的GLB交付文件",
  "version": "0.8.0",
  "changelog": "原生glTF Transform读写、材质修订与完整工程恢复。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "models",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "models",
      "access": "read-write"
    },
    {
      "id": "notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    }
  ]
}
