{
  "schemaVersion": 1,
  "appId": "workbench.72ac1e9f-d1e4-4764-b108-cd5d20bc31bc",
  "registryName": "deerflow-studio",
  "name": "研究交付 · DeerFlow",
  "description": "研究任务提交、状态恢复、证据复核与报告交付",
  "version": "0.5.0",
  "changelog": "以官方后台run API提交研究，先持久化命令，未知回执只读恢复；自动保存报告、证据与工作稿。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "upstream-notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    },
    {
      "id": "setup-guide",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "SETUP.md"
    }
  ]
}
