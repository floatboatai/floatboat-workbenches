{
  "schemaVersion": 1,
  "appId": "workbench.72ac1e9f-d1e4-4764-b108-cd5d20bc31bc",
  "registryName": "deerflow-studio",
  "name": "深度研究 · DeerFlow",
  "description": "研究问题→可编辑计划与人工确认→本地检索或DeerFlow执行→带引用的报告",
  "version": "0.9.0",
  "changelog": "0.9.0：深度研究工作台。问题→计划（模板或Floatboat模型起草，逐步编辑、人工确认）→执行（Node内置网页直读/Jina/Exa/GitHub检索，或DeerFlow后台研究与SSE实时进度）→带[编号]引用的报告编辑器、来源核验与引用跳转、Markdown/HTML导出；DeerFlow地址可在页面设置并重新检查；示例为已完成的SQLite WAL选型研究。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [
    "llm"
  ],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "upstream-notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    },
    {
      "id": "setup-guide",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "SETUP.md"
    }
  ]
}
