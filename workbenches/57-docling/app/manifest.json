{
  "schemaVersion": 1,
  "appId": "workbench.eace0c23-7f0d-4c80-888b-6a1f0cccb38e",
  "registryName": "docling-studio",
  "name": "Docling 工作台",
  "description": "把 PDF、Word、HTML、Markdown 转成 DoclingDocument，在原页上框选对照并校订",
  "version": "0.9.0",
  "changelog": "本地解析 PDF/Word/HTML/Markdown（无需服务）；原页框选对照；Docling Serve 支持全部官方格式与转换选项，状态与启动方式紧贴转换操作；HTML/CSV/校对包导出；多页含表格的示例。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "documents",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "documents",
      "access": "read-write"
    },
    {
      "id": "examples",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "fixtures"
    },
    {
      "id": "pdfjs-assets",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "pdfjs"
    }
  ]
}
