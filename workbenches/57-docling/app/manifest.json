{
  "schemaVersion": 1,
  "appId": "workbench.eace0c23-7f0d-4c80-888b-6a1f0cccb38e",
  "registryName": "docling-studio",
  "name": "Docling 工作台",
  "description": "文档结构、文本与表格校对台",
  "version": "0.4.1",
  "changelog": "共享自动保存修复：成功保存后立即切换文档不再误报“本机缓存尚未修复”。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "documents",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "documents",
      "access": "read-write"
    },
    {
      "id": "examples",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "fixtures"
    }
  ]
