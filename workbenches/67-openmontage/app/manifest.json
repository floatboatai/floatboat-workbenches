{
  "schemaVersion": 1,
  "appId": "workbench.289e934c-fb6d-4354-a757-3f8d81327fd8",
  "registryName": "openmontage-studio",
  "name": "镜头制作 · OpenMontage",
  "description": "分镜审阅、本地视频素材裁切与拼接交付",
  "version": "0.5.1",
  "changelog": "共享自动保存修复：成功保存后立即切换文档不再误报“本机缓存尚未修复”。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "notices",
      "kind": "directory",
      "role": "asset",
      "location": "project",
      "path": "notices"
    },
    {
      "id": "media",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "media",
      "access": "read-write"
    },
    {
      "id": "setup-guide",
      "kind": "file",
      "role": "asset",
      "location": "project",
      "path": "SETUP.md"
    }
  ]
}
