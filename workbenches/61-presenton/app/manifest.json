{
  "schemaVersion": 1,
  "appId": "workbench.a5516be6-2e0a-4cca-be12-9efb56bd0373",
  "registryName": "presenton-studio",
  "name": "Presenton 工作台",
  "description": "资料 → 大纲 → 成稿的演示文稿生成台",
  "version": "0.9.0",
  "changelog": "重建为不依赖服务的生成工作流：读入资料（md/txt/docx/html/csv），本地确定性生成大纲（表格→原生图表、数字→关键数字、时间线、对比、引语），11 种版式与 5 套主题的舞台逐页编辑（图表数据、图片、版式切换），导出 PPTX（原生图表与备注）与 PDF；Floatboat 模型起草与 Presenton 服务为可选通道，均有状态与重新检查。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [
    "llm"
  ],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "generated-files",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "generated-files",
      "access": "read-write"
    }
  ]
}
