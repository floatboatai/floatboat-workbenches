{
  "schemaVersion": 1,
  "appId": "workbench.a5516be6-2e0a-4cca-be12-9efb56bd0373",
  "registryName": "presenton-studio",
  "name": "Presenton 工作台",
  "description": "资料 → 大纲 → 成稿的演示文稿生成台",
  "version": "0.9.1",
  "changelog": "AI 功能默认使用 gemini-3.8-flash：工作台 SDK 在调用未指定模型时固定使用该模型，不再随 Floatboat 远端配置变化。应用其余功能不变。",
  "sdkVersion": "1.0.0",
  "runtime": "node22-sqlite-v1",
  "build": {
    "profile": "typescript-react-v1",
    "server": "src/server/index.ts",
    "ui": "index.html"
  },
  "server": "dist/server/index.mjs",
  "ui": "dist/ui",
  "migrations": "migrations",
  "capabilities": [
    "llm"
  ],
  "contributions": [],
  "dependencies": [],
  "resources": [
    {
      "id": "generated-files",
      "kind": "directory",
      "role": "data",
      "location": "data",
      "path": "generated-files",
      "access": "read-write"
    }
  ]
}
